{
  "rules": [
    { "spoken": ["greater than or equal to"], "symbol": "≥", "position": "infix" },
    { "spoken": ["less than or equal to"], "symbol": "≤", "position": "infix" },
    { "spoken": ["is equal to", "equal to", "equals"], "symbol": "=", "position": "infix" },
    { "spoken": ["to the power of (\\d+)", "to the power of (one|two|three|four|five|six|seven|eight|nine|ten)"], "symbol": "^$1", "position": "postfix", "regex": true },
    { "spoken": ["squared"], "symbol": "²", "position": "postfix" },
    { "spoken": ["cubed"], "symbol": "³", "position": "postfix" },
    { "spoken": ["times", "multiplied by", "into"], "symbol": "×", "position": "infix" },
    { "spoken": ["divided by", "over"], "symbol": "/", "position": "infix" },
    { "spoken": ["plus"], "symbol": "+", "position": "infix" },
    { "spoken": ["minus", "subtract"], "symbol": "−", "position": "infix" },
    { "spoken": ["greater than"], "symbol": ">", "position": "infix" },
    { "spoken": ["less than"], "symbol": "<", "position": "infix" },
    { "spoken": ["square root of"], "symbol": "√", "position": "prefix" },
    { "spoken": ["approximately"], "symbol": "≈", "position": "infix" },
    
    { "spoken": ["expected value", "expectation of"], "symbol": "E[]", "position": "prefix" },
    { "spoken": ["variance", "variance of"], "symbol": "Var()", "position": "prefix" },
    { "spoken": ["covariance", "covariance of"], "symbol": "Cov(,)", "position": "prefix" },
    { "spoken": ["r bar", "risk free rate"], "symbol": "r̄" },
    { "spoken": ["q measure", "risk neutral measure"], "symbol": "ℚ" },
    { "spoken": ["probability", "prob"], "symbol": "ℙ" },
    { "spoken": ["real numbers", "the reals"], "symbol": "ℝ" },
    { "spoken": ["integers"], "symbol": "ℤ" },
    { "spoken": ["for all"], "symbol": "∀", "position": "prefix" },
    { "spoken": ["there exists", "exists"], "symbol": "∃", "position": "prefix" },
    { "spoken": ["is in", "belongs to"], "symbol": "∈", "position": "infix" },
    { "spoken": ["not in"], "symbol": "∉", "position": "infix" },
    { "spoken": ["subset of"], "symbol": "⊂", "position": "infix" },
    { "spoken": ["intersection of", "inter"], "symbol": "∩", "position": "infix" },
    { "spoken": ["union of", "union"], "symbol": "∪", "position": "infix" },
    
    { "spoken": ["sum from (\\w+) equals (\\w+) to (\\w+)", "summation from (\\w+) equals (\\w+) to (\\w+)"], "symbol": "Σ_{$1=$2}^{$3}", "regex": true },
    { "spoken": ["integral from (\\w+) to (\\w+)"], "symbol": "∫_{$1}^{$2}", "regex": true },
    { "spoken": ["integral of"], "symbol": "∫", "position": "prefix" },
    { "spoken": ["partial of"], "symbol": "∂", "position": "prefix" },
    { "spoken": ["implies", "if then"], "symbol": "⇒", "position": "infix" },
    { "spoken": ["equivalent to", "is equivalent"], "symbol": "≡", "position": "infix" },
    { "spoken": ["therefore", "hence"], "symbol": "∴", "position": "prefix" },
    
    { "spoken": ["pi"], "symbol": "π" },
    { "spoken": ["alpha"], "symbol": "α" },
    { "spoken": ["beta"], "symbol": "β" },
    { "spoken": ["gamma"], "symbol": "γ" },
    { "spoken": ["theta"], "symbol": "θ" },
    { "spoken": ["delta"], "symbol": "Δ" },
    { "spoken": ["sigma"], "symbol": "Σ" },
    { "spoken": ["mu"], "symbol": "μ" },
    { "spoken": ["rho"], "symbol": "ρ" },
    { "spoken": ["lambda"], "symbol": "λ" },
    { "spoken": ["tau"], "symbol": "τ" },
    { "spoken": ["phi"], "symbol": "φ" },
    { "spoken": ["omega"], "symbol": "ω" },
    { "spoken": ["eta"], "symbol": "η" },
    { "spoken": ["nu"], "symbol": "ν" },
    { "spoken": ["epsilon"], "symbol": "ε" },
    
    { "spoken": ["subscript i"], "symbol": "ᵢ", "position": "postfix" },
    { "spoken": ["subscript t"], "symbol": "ₜ", "position": "postfix" },
    { "spoken": ["subscript n"], "symbol": "ₙ", "position": "postfix" },
    { "spoken": ["superscript (\\w+)"], "symbol": "^$1", "position": "postfix", "regex": true },
    
    { "spoken": ["point", "dot"], "symbol": "." },
    { "spoken": ["zero"], "symbol": "0" },
    { "spoken": ["one"], "symbol": "1" },
    { "spoken": ["two"], "symbol": "2" },
    { "spoken": ["three"], "symbol": "3" },
    { "spoken": ["four"], "symbol": "4" },
    { "spoken": ["five"], "symbol": "5" },
    { "spoken": ["six"], "symbol": "6" },
    { "spoken": ["seven"], "symbol": "7" },
    { "spoken": ["eight"], "symbol": "8" },
    { "spoken": ["nine"], "symbol": "9" },
    { "spoken": ["ten"], "symbol": "10" }
  ]
}
